rules_version = '2';
// Gym Tracker. Each person's log is theirs; a friend reads it while the owner's friends list names them.
// Tested in rules/firestore.rules.test.ts against the emulator (npm run test:rules).
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function me(uid) { return signedIn() && request.auth.uid == uid; }
    function friendOf(uid) { return signedIn() && exists(/databases/$(db)/documents/users/$(uid)/friends/$(request.auth.uid)); }
    // The app's owner (social S2): the one account that grants the ✓ (config/verified below). Room for a second moderator: one
    // more uid in this list (owner, 2026-10-22); the app holds the same list (src/cloud/owner.ts, a test checks they agree).
    function OWNERS() { return ['FKCm35XFmSZyVtn3XdtO9TBJmOw2']; }
    function owner() { return signedIn() && request.auth.uid in OWNERS(); }
    function blocked(uid, them) { return exists(/databases/$(db)/documents/users/$(uid)/blocked/$(them)); }
    function liveInvite(uid, token) {
      return token is string && exists(/databases/$(db)/documents/users/$(uid)/invites/$(token))
        && get(/databases/$(db)/documents/users/$(uid)/invites/$(token)).data.expires > request.time;
    }

    // The compare summary's shape (domain/compare Summary): these keys and no others, every range, each series 13 points, at most
    // 12 lifts a range and 8 firsts, the first of each list in its shape (a request may evaluate only 1,000 expressions: one entry
    // each fits, all of them don't). Every key is read below, so one missing or of another type errors, and an error refuses.
    // What's inside a list isn't checked entry by entry: the app reads every friend's summary as untrusted (compare
    // parseSummary) and drops what isn't in shape.
    function isDay(s) { return s.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function nameOk(s) { return s.matches('(?s)^.{1,60}$'); }
    function liftOk(l) { return l.keys().hasOnly(['n', 's']) && nameOk(l.n) && l.s is list && l.s.size() == 13; }
    function firstOk(f) { return f.keys().hasOnly(['n', 'w', 'd']) && nameOk(f.n) && f.w >= 0 && f.w <= 2000 && isDay(f.d); }
    function rangeOk(x, met) {
      return x.keys().hasOnly(['met', 'vol', 'prs', 'lifts']) && x.met.matches(met)
        && x.vol is list && (x.vol.size() == 0 || x.vol.size() == 13)
        && x.prs is list && x.prs.size() == 13
        && x.lifts is list && x.lifts.size() <= 12 && (x.lifts.size() == 0 || liftOk(x.lifts[0]));
    }
    function summaryOk(d) {
      return d.keys().hasOnly(['v', 'at', 'day', 'goal', 'streak', 'r', 'firsts'])
        && d.v == 1 && d.at == request.time && isDay(d.day)
        && d.goal is int && d.goal >= 1 && d.goal <= 7
        && d.streak is int && d.streak >= 0 && d.streak <= 1000
        && d.r.keys().hasOnly(['4w', '12w', '1y'])
        && rangeOk(d.r['4w'], '^[01]{4}$') && rangeOk(d.r['12w'], '^[01]{12}$') && rangeOk(d.r['1y'], '^[01]{52}$')
        && d.firsts is list && d.firsts.size() <= 8 && (d.firsts.size() == 0 || firstOk(d.firsts[0]));
    }

    // Exact-name lookup only: nobody can list who's here. A name is held by the one profile that goes by it: claimed in the
    // write that names your profile by it, released only in the write that moves your profile off it (or deletes the account).
    function nameDoc(n) { return /databases/$(db)/documents/usernames/$(n); }
    function profileDoc(uid) { return /databases/$(db)/documents/users/$(uid); }
    function holdsAfter(uid, n) { return n is string && existsAfter(nameDoc(n)) && getAfter(nameDoc(n)).data.uid == uid; }
    // The ✓ (social S2): uids the owner has confirmed are who they say, each with when. Anyone signed in reads it (one read, kept
    // on the phone); only the owner writes it.
    match /config/verified {
      allow get: if signedIn();
      allow create, update: if owner() && request.resource.data.keys().hasOnly(['uids']) && request.resource.data.uids is map;
      allow delete: if owner();
    }

    match /usernames/{name} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && name.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid == request.auth.uid
        && getAfter(profileDoc(request.auth.uid)).data.username == name;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid
        && (!existsAfter(profileDoc(request.auth.uid)) || getAfter(profileDoc(request.auth.uid)).data.username != name);
    }

    // A display name (social S1): free text shown beside the @username, never instead of it. 1 to 60 UTF-16 units (the app holds
    // it to 30 characters as a person counts them), no control, invisible or direction-flipping characters, no @, no link, no
    // space at either end, and nothing drawn like the ✓. The app checks the same class (domain/displayName; a test checks they
    // agree). Joiners (U+200C, U+200D) stay: emoji like 🏋️‍♀️ and some scripts are built with them.
    function dnOk(s) {
      return s is string && s.size() >= 1 && s.size() <= 60
        && s.matches('[^@\\x{0}-\\x{1f}\\x{7f}-\\x{9f}\\x{ad}\\x{61c}\\x{200b}\\x{200e}\\x{200f}\\x{2028}-\\x{202e}\\x{2060}-\\x{2064}\\x{2066}-\\x{2069}\\x{feff}\\x{ae}\\x{2122}\\x{221a}\\x{2611}\\x{2705}\\x{2713}\\x{2714}\\x{1f535}\\x{1f5f8}]+')
        && !s.matches('(?s)( .*|.* )')
        && !s.matches('(?is).*(://|www[.]).*');
    }
    // No display name set: the old shape, the display name the username itself (every profile before S1, and an older app's writes).
    function plainName(d) { return d.displayName == d.username; }
    // The username part of a profile's change: untouched, or a change as below (the new name held and the old one released in
    // the same write, `prev` the old one, the server's time, at most once a day).
    function usernameMove(uid, n, o) {
      return !n.diff(o).affectedKeys().hasAny(['username', 'prev', 'changedAt'])
        || (n.username != o.username && holdsAfter(uid, n.username) && !existsAfter(nameDoc(o.username))
          && n.prev == o.username && n.changedAt == request.time
          && (!('changedAt' in o) || request.time > o.changedAt + duration.value(1, 'd')));
    }
    // The display name part: untouched; the old shape following a change of username; an older app's change of username, which
    // writes the old shape whole (a display name set goes with its time, but not within a day of setting it); or a change of its
    // own (set, changed or cleared back to the old shape) at the server's time, at most once a day.
    function displayMove(n, o) {
      let ch = n.diff(o).affectedKeys();
      return (plainName(n) || dnOk(n.displayName))
        && (!ch.hasAny(['displayName', 'nameAt'])
          || (plainName(n) && plainName(o) && !ch.hasAny(['nameAt']))
          || (plainName(n) && n.username != o.username && !('nameAt' in n)
            && (!('nameAt' in o) || request.time > o.nameAt + duration.value(1, 'd')))
          || (ch.hasAny(['displayName']) && n.nameAt == request.time
            && (!('nameAt' in o) || request.time > o.nameAt + duration.value(1, 'd'))));
    }

    match /users/{uid} {
      // Name only, so a request can say who it's from; `prev` and `changedAt` say what it was ("formerly @…" for 30 days); the
      // display name and when it last changed (`nameAt`); when the account first had a profile (`createdAt`, the server's time,
      // kept for the board's day-old gate; an older app writes none, and a profile without one may add it once, as now).
      allow get: if signedIn();
      // A first name: one you hold, no display name yet.
      allow create: if me(uid) && request.resource.data.keys().hasOnly(['username', 'displayName', 'createdAt'])
        && request.resource.data.displayName == request.resource.data.username && holdsAfter(uid, request.resource.data.username)
        && (!('createdAt' in request.resource.data) || request.resource.data.createdAt == request.time);
      allow update: if me(uid)
        && request.resource.data.keys().hasOnly(['username', 'displayName', 'prev', 'changedAt', 'nameAt', 'createdAt'])
        && usernameMove(uid, request.resource.data, resource.data)
        && displayMove(request.resource.data, resource.data)
        && (!('createdAt' in request.resource.data) || request.resource.data.createdAt == resource.data.get('createdAt', request.time));
      allow delete: if me(uid);

      match /months/{m} { allow read: if me(uid) || friendOf(uid); allow write: if me(uid); }
      match /meta/{d}   { allow read: if me(uid) || friendOf(uid); allow write: if me(uid); }
      // Yours alone, never a friend's to read: cycle phase (domain/cycle).
      match /private/{d} { allow read, write: if me(uid); }
      // Compare: what your phone publishes for friends to set side by side (domain/compare summarize), one small document of
      // per-range numbers and no sets. A friend gets it, one read; nobody lists it but you. Only you write it, in its shape, at
      // the server's time.
      match /summary/{d} {
        allow get: if me(uid) || friendOf(uid);
        allow list: if me(uid);
        allow create, update: if me(uid) && d == 'compare' && summaryOk(request.resource.data);
        allow delete: if me(uid);
      }

      match /friends/{f} {
        allow read: if me(uid);
        allow delete: if me(uid) || me(f);
        // Your own list; or the friend adds themselves, holding your invite (used up in the same write: it works once)
        // or answering their request you sent. Never someone you've blocked.
        allow create: if me(uid)
          || (me(f) && !blocked(uid, f) && liveInvite(uid, request.resource.data.via)
              && !existsAfter(/databases/$(db)/documents/users/$(uid)/invites/$(request.resource.data.via)))
          || (me(f) && !blocked(uid, f) && exists(/databases/$(db)/documents/users/$(f)/requests/$(uid)));
        // Only yours, and only these two: muting them (they never see it) and when you last read their messages (no read
        // receipts: nobody but you reads your list).
        allow update: if me(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['muted', 'readAt'])
          && (!('muted' in request.resource.data) || request.resource.data.muted is bool)
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['readAt']) || request.resource.data.readAt == request.time);
      }
      // Who you've blocked: yours alone.
      match /blocked/{them} {
        allow read, delete: if me(uid);
        allow create, update: if me(uid) && request.resource.data.keys().hasOnly(['at']);
      }
      match /invites/{t} {
        allow read, write: if me(uid);
        allow get: if signedIn();
        // Used up by whoever accepts it, in the write that makes them a friend through it (see friends above).
        allow delete: if signedIn() && resource.data.expires > request.time
          && !exists(/databases/$(db)/documents/users/$(uid)/friends/$(request.auth.uid))
          && getAfter(/databases/$(db)/documents/users/$(uid)/friends/$(request.auth.uid)).data.via == t;
      }
      match /requests/{from} {
        allow create: if me(from) && from != uid && exists(/databases/$(db)/documents/users/$(uid)) && !blocked(uid, from)
          && request.resource.data.keys().hasOnly(['username', 'sent']);
        allow read, delete: if me(uid) || me(from);
      }
      // A gym a friend sent you: they create it as themselves, only you read or clear it, nobody rewrites it.
      // Its sender may get that one document back: the push Worker reads it with their token to check the gym is theirs.
      match /gymInbox/{id} {
        allow create: if signedIn() && request.resource.data.from == request.auth.uid && friendOf(uid)
          && request.resource.data.keys().hasOnly(['from', 'fromName', 'gym', 'sent']);
        allow read, delete: if me(uid);
        allow get: if signedIn() && resource.data.from == request.auth.uid;
      }
      // Pings and messages a friend sent you. They write it as themselves, while they're your friend, with the server's
      // time, a known ping or 1 to 140 characters, and their own send counter moved in the same write (sendRate, below).
      // You read and clear yours; a sender reads back only their own (the app asks with where from == them). Never edited.
      match /inbox/{id} {
        allow create: if friendOf(uid) && request.resource.data.from == request.auth.uid && request.resource.data.at == request.time
          && ((request.resource.data.kind == 'p' && request.resource.data.keys().hasOnly(['from', 'kind', 'e', 'at'])
                && request.resource.data.e in ['strong', 'fire', 'clap', 'gym', 'eyes', 'salute'])
            || (request.resource.data.kind == 'm' && request.resource.data.keys().hasOnly(['from', 'kind', 't', 'at'])
                && request.resource.data.t is string && request.resource.data.t.size() >= 1 && request.resource.data.t.size() <= 140))
          && getAfter(/databases/$(db)/documents/users/$(request.auth.uid)/sendRate/$(uid)).data.at == request.time;
        allow read: if me(uid) || (signedIn() && resource.data.from == request.auth.uid);
        allow delete: if me(uid);
        allow update: if false;
      }
      // Your own send counter to one friend: 2 s between sends, 30 an hour (a new hour starts the count again). Only
      // removable once its hour is over, or with the account itself (its profile goes in the same write).
      match /sendRate/{to} {
        allow read: if me(uid);
        allow create: if me(uid) && request.resource.data.keys().hasOnly(['at', 'win', 'n'])
          && request.resource.data.at == request.time && request.resource.data.win == request.time && request.resource.data.n == 1;
        allow update: if me(uid) && request.resource.data.keys().hasOnly(['at', 'win', 'n'])
          && request.resource.data.at == request.time && request.time > resource.data.at + duration.value(2, 's')
          && ((request.resource.data.win == resource.data.win && request.resource.data.n == resource.data.n + 1
                && request.resource.data.n <= 30 && request.time < resource.data.win + duration.value(1, 'h'))
            || (request.resource.data.win == request.time && request.resource.data.n == 1
                && request.time >= resource.data.win + duration.value(1, 'h')));
        allow delete: if me(uid) && (request.time >= resource.data.win + duration.value(1, 'h')
          || !existsAfter(/databases/$(db)/documents/users/$(uid)));
      }
    }
  }
}
