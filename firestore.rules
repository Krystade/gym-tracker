rules_version = '2';
// Gym Tracker. Each person's log is theirs; a friend reads it while the owner's friends list names them.
// Tested in rules/firestore.rules.test.ts against the emulator (npm run test:rules).
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function me(uid) { return signedIn() && request.auth.uid == uid; }
    function friendOf(uid) { return signedIn() && exists(/databases/$(db)/documents/users/$(uid)/friends/$(request.auth.uid)); }
    // The app's owner (social S2): the one account that grants the ✓ (config/verified below). Room for a second moderator: one
    // more uid in this list (owner, 2026-10-22); the app holds the same list (src/cloud/owner.ts, a test checks they agree).
    function OWNERS() { return ['FKCm35XFmSZyVtn3XdtO9TBJmOw2']; }
    function owner() { return signedIn() && request.auth.uid in OWNERS(); }
    function blocked(uid, them) { return exists(/databases/$(db)/documents/users/$(uid)/blocked/$(them)); }
    function liveInvite(uid, token) {
      return token is string && exists(/databases/$(db)/documents/users/$(uid)/invites/$(token))
        && get(/databases/$(db)/documents/users/$(uid)/invites/$(token)).data.expires > request.time;
    }

    // The compare summary's shape (domain/compare Summary): these keys and no others, every range, each series 13 points, at most
    // 12 lifts a range and 8 firsts, the first of each list in its shape (a request may evaluate only 1,000 expressions: one entry
    // each fits, all of them don't). Every key is read below, so one missing or of another type errors, and an error refuses.
    // What's inside a list isn't checked entry by entry: the app reads every friend's summary as untrusted (compare
    // parseSummary) and drops what isn't in shape.
    function isDay(s) { return s.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function nameOk(s) { return s.matches('(?s)^.{1,60}$'); }
    function liftOk(l) { return l.keys().hasOnly(['n', 's']) && nameOk(l.n) && l.s is list && l.s.size() == 13; }
    function firstOk(f) { return f.keys().hasOnly(['n', 'w', 'd']) && nameOk(f.n) && f.w >= 0 && f.w <= 2000 && isDay(f.d); }
    // An achievement (domain/achievements SharedAch): its family's id, the level, the day, the lift for a per-lift one.
    function achOk(a) {
      return a.keys().hasOnly(['i', 'l', 'd', 'n']) && a.i is string && a.i.matches('^[a-z-]{1,20}$')
        && a.l is int && a.l >= 0 && a.l <= 4 && isDay(a.d) && (!('n' in a) || nameOk(a.n));
    }
    function rangeOk(x, met) {
      return x.keys().hasOnly(['met', 'vol', 'prs', 'lifts']) && x.met.matches(met)
        && x.vol is list && (x.vol.size() == 0 || x.vol.size() == 13)
        && x.prs is list && x.prs.size() == 13
        && x.lifts is list && x.lifts.size() <= 12 && (x.lifts.size() == 0 || liftOk(x.lifts[0]));
    }
    function summaryOk(d) {
      return d.keys().hasOnly(['v', 'at', 'day', 'goal', 'streak', 'r', 'firsts', 'ach'])
        && d.v == 1 && d.at == request.time && isDay(d.day)
        && d.goal is int && d.goal >= 1 && d.goal <= 7
        && d.streak is int && d.streak >= 0 && d.streak <= 1000
        && d.r.keys().hasOnly(['4w', '12w', '1y'])
        && rangeOk(d.r['4w'], '^[01]{4}$') && rangeOk(d.r['12w'], '^[01]{12}$') && rangeOk(d.r['1y'], '^[01]{52}$')
        && d.firsts is list && d.firsts.size() <= 8 && (d.firsts.size() == 0 || firstOk(d.firsts[0]))
        && (!('ach' in d) || (d.ach is list && d.ach.size() <= 32 && (d.ach.size() == 0 || achOk(d.ach[0]))));
    }

    // Exact-name lookup only: nobody can list who's here. A name is held by the one profile that goes by it: claimed in the
    // write that names your profile by it, released only in the write that moves your profile off it (or deletes the account).
    function nameDoc(n) { return /databases/$(db)/documents/usernames/$(n); }
    function profileDoc(uid) { return /databases/$(db)/documents/users/$(uid); }
    function holdsAfter(uid, n) { return n is string && existsAfter(nameDoc(n)) && getAfter(nameDoc(n)).data.uid == uid; }
    // The ✓ (social S2): uids the owner has confirmed are who they say, each with when. Anyone signed in reads it (one read, kept
    // on the phone); only the owner writes it.
    match /config/verified {
      allow get: if signedIn();
      allow create, update: if owner() && request.resource.data.keys().hasOnly(['uids']) && request.resource.data.uids is map;
      allow delete: if owner();
    }

    match /usernames/{name} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && name.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid == request.auth.uid
        && getAfter(profileDoc(request.auth.uid)).data.username == name;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid
        && (!existsAfter(profileDoc(request.auth.uid)) || getAfter(profileDoc(request.auth.uid)).data.username != name);
    }

    // A display name (social S1): free text shown beside the @username, never instead of it. 1 to 60 UTF-16 units (the app holds
    // it to 30 characters as a person counts them), no control, invisible or direction-flipping characters, no @, no link, no
    // space at either end, and nothing drawn like the ✓. The app checks the same class (domain/displayName; a test checks they
    // agree). Joiners (U+200C, U+200D) stay: emoji like 🏋️‍♀️ and some scripts are built with them.
    function dnOk(s) {
      return s is string && s.size() >= 1 && s.size() <= 60
        && s.matches('[^@\\x{0}-\\x{1f}\\x{7f}-\\x{9f}\\x{ad}\\x{61c}\\x{200b}\\x{200e}\\x{200f}\\x{2028}-\\x{202e}\\x{2060}-\\x{2064}\\x{2066}-\\x{2069}\\x{feff}\\x{ae}\\x{2122}\\x{221a}\\x{2611}\\x{2705}\\x{2713}\\x{2714}\\x{1f535}\\x{1f5f8}]+')
        && !s.matches('(?s)( .*|.* )')
        && !s.matches('(?is).*(://|www[.]).*');
    }
    // No display name set: the old shape, the display name the username itself (every profile before S1, and an older app's writes).
    function plainName(d) { return d.displayName == d.username; }
    // The username part of a profile's change: untouched, or a change as below (the new name held and the old one released in
    // the same write, `prev` the old one, the server's time, at most once a day).
    function usernameMove(uid, n, o) {
      return !n.diff(o).affectedKeys().hasAny(['username', 'prev', 'changedAt'])
        || (n.username != o.username && holdsAfter(uid, n.username) && !existsAfter(nameDoc(o.username))
          && n.prev == o.username && n.changedAt == request.time
          && (!('changedAt' in o) || request.time > o.changedAt + duration.value(1, 'd')));
    }
    // The display name part: untouched; the old shape following a change of username; an older app's change of username, which
    // writes the old shape whole (a display name set goes with its time, but not within a day of setting it); or a change of its
    // own (set, changed or cleared back to the old shape) at the server's time, at most once a day.
    function displayMove(n, o) {
      let ch = n.diff(o).affectedKeys();
      return (plainName(n) || dnOk(n.displayName))
        && (!ch.hasAny(['displayName', 'nameAt'])
          || (plainName(n) && plainName(o) && !ch.hasAny(['nameAt']))
          || (plainName(n) && n.username != o.username && !('nameAt' in n)
            && (!('nameAt' in o) || request.time > o.nameAt + duration.value(1, 'd')))
          || (ch.hasAny(['displayName']) && n.nameAt == request.time
            && (!('nameAt' in o) || request.time > o.nameAt + duration.value(1, 'd'))));
    }

    // ---- Limits (r28): the owner's switches, your social counter, and the app's daily counter ----
    // Spark can't bill: past a quota Firestore stops answering until the daily reset. These keep one account, or a few, from
    // using up the day for everyone. Plan: .superpowers/security/rate-limits.md (local). The numbers are domain/limits'.
    // The owner's switches (More > Board review): `board`, `requests`, `messages` true closes that for everyone but reading.
    function switchDoc() { return /databases/$(db)/documents/config/switches; }
    function closed(k) { return exists(switchDoc()) && get(switchDoc()).data.get(k, false) == true; }
    // The app's counter for the day (UTC days since 1970): every social write of anyone's moves it by one, 2,000 a day at most.
    // Anyone may read it (the push Worker's cron does, without an account, to tell the owner when it's full).
    function dayId() { return string(int(request.time.toMillis() / 86400000)); }
    function dayDoc() { return /databases/$(db)/documents/limits/$(dayId()); }
    function globalMoved() {
      return (!exists(dayDoc()) && getAfter(dayDoc()).data.n == 1) || (exists(dayDoc()) && getAfter(dayDoc()).data.n == get(dayDoc()).data.n + 1);
    }
    // Your social counter (socialRate: likes, friend requests, invites, gyms, pings and messages, 300 a day) moved in this write.
    function socialMoved() { return getAfter(/databases/$(db)/documents/socialRate/$(request.auth.uid)).data.at == request.time; }
    function counted() { return socialMoved() && globalMoved(); }
    // Only beside a counter of your own moved in the same write (your social one, or a post's), so nobody moves the day's alone.
    function ownMoved() {
      return socialMoved() || getAfter(/databases/$(db)/documents/boardRate/$(request.auth.uid)).data.at == request.time;
    }
    match /config/switches {
      allow get: if signedIn();
      allow create, update: if owner() && request.resource.data.keys().hasOnly(['board', 'requests', 'messages', 'at'])
        && request.resource.data.get('board', false) is bool && request.resource.data.get('requests', false) is bool
        && request.resource.data.get('messages', false) is bool && request.resource.data.at == request.time;
      allow delete: if owner();
    }
    match /limits/{day} {
      allow get: if true;
      allow list: if owner();
      allow create: if signedIn() && day == dayId() && request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == 1 && ownMoved();
      allow update: if signedIn() && day == dayId() && request.resource.data.keys().hasOnly(['n'])
        && request.resource.data.n == resource.data.n + 1 && request.resource.data.n <= 2000 && ownMoved();
      allow delete: if owner();
    }
    match /socialRate/{uid} {
      allow get: if me(uid);
      allow create: if me(uid) && rateFirst(request.resource.data);
      allow update: if me(uid) && rateNext(request.resource.data, resource.data, duration.value(0, 's'), 300);
      allow delete: if me(uid) && (request.time >= resource.data.win + duration.value(1, 'd') || !existsAfter(profileDoc(uid)));
    }

    // ---- The board (social S3, S4): one page of short posts every signed-in person reads ----
    function banned(uid) { return exists(/databases/$(db)/documents/banned/$(uid)); }
    function prof(uid) { return get(profileDoc(uid)).data; }
    function postDoc(id) { return /databases/$(db)/documents/board/$(id); }
    // To write on the board: not banned, the one-time "16 or older, and the board's rules" on your own private/board (ok), and an
    // account a day old by its profile's createdAt (the server's time; a profile from before S1 gets one on its next open, so it
    // waits a day from then). No verified email (owner, 2026-10-22). Any part missing errors, and an error refuses.
    function boardOk() {
      return signedIn() && !banned(request.auth.uid)
        && get(/databases/$(db)/documents/users/$(request.auth.uid)/private/board).data.ok == true
        && request.time > prof(request.auth.uid).createdAt + duration.value(1, 'd');
    }
    // A post's words: 1 to 280 UTF-16 units (as a JS string's length counts), and no link.
    function textOk(t) { return t is string && t.size() >= 1 && t.size() <= 280 && !t.matches('(?is).*(://|www[.]).*'); }
    // A post as its author writes it: these keys, as themselves, at the server's time, nothing counted yet, the name and
    // @username their profile has now, and their post counter moved in the same write (boardRate).
    function postOk(d) {
      return d.keys().hasOnly(['uid', 'name', 'user', 't', 'at', 'reports', 'likes'])
        && d.uid == request.auth.uid && d.at == request.time && d.reports == 0 && d.likes == 0 && textOk(d.t)
        && d.user == prof(request.auth.uid).username && d.name == prof(request.auth.uid).get('displayName', d.user)
        && getAfter(/databases/$(db)/documents/boardRate/$(request.auth.uid)).data.at == request.time;
    }
    // The counts others may move, each by one and only with the document that stands for it: a report goes up as yours is
    // made; a 💪 goes up or down as yours is made or taken back. The owner marks the reports so far reviewed (`kept`).
    function reportMove(id) {
      let r = /databases/$(db)/documents/board/$(id)/reports/$(request.auth.uid);
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reports'])
        && request.resource.data.reports == resource.data.reports + 1 && !exists(r) && existsAfter(r);
    }
    function likeMove(id) {
      let l = /databases/$(db)/documents/board/$(id)/likes/$(request.auth.uid);
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
        && ((request.resource.data.likes == resource.data.likes + 1 && !exists(l) && existsAfter(l))
          || (request.resource.data.likes == resource.data.likes - 1 && exists(l) && !existsAfter(l)));
    }
    function keepMove() {
      return owner() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['kept'])
        && request.resource.data.kept is int && request.resource.data.kept >= 0 && request.resource.data.kept <= request.resource.data.reports;
    }
    // A counter of yours (boardRate: posts, 60 s apart and 5 a day; reportRate: reports, 20 a day): the first, and each after it
    // at the server's time, `gap` after the last, counting up within the day its first began, or starting again at 1 after it.
    function rateFirst(d) { return d.keys().hasOnly(['at', 'win', 'n']) && d.at == request.time && d.win == request.time && d.n == 1; }
    function rateNext(n, o, gap, max) {
      return n.keys().hasOnly(['at', 'win', 'n']) && n.at == request.time && request.time > o.at + gap
        && ((n.win == o.win && n.n == o.n + 1 && n.n <= max && request.time < o.win + duration.value(1, 'd'))
          || (n.win == request.time && n.n == 1 && request.time >= o.win + duration.value(1, 'd')));
    }

    // Posts: anyone signed in reads them (the app asks for the last 30 days, 20 at a time); the author or an owner deletes one.
    match /board/{id} {
      allow get, list: if signedIn();
      allow create: if boardOk() && !closed('board') && postOk(request.resource.data) && globalMoved();
      allow update: if signedIn() && (reportMove(id) || likeMove(id) || keepMove());
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || owner());
      // One report per person per post: made past the gate, as yourself, for one of six reasons, at the server's time, with the
      // post's count up one and your report counter moved in the same write. The owner reads them; a reporter gets their own back
      // (the push Worker checks it with their token). Nobody edits one.
      match /reports/{r} {
        allow get: if owner() || me(r);
        allow list: if owner();
        allow create: if me(r) && boardOk() && request.resource.data.keys().hasOnly(['why', 'at'])
          && request.resource.data.why in ['harass', 'spam', 'personal', 'sexual', 'danger', 'other'] && request.resource.data.at == request.time
          && getAfter(postDoc(id)).data.reports == get(postDoc(id)).data.reports + 1
          && getAfter(/databases/$(db)/documents/reportRate/$(r)).data.at == request.time;
        allow delete: if owner();
      }
      // One 💪 per person per post, empty, with the post's count moved by one in the same write; an owner clears them as the post goes.
      match /likes/{l} {
        allow get: if signedIn();
        allow list: if owner();
        allow create: if me(l) && !banned(l) && !closed('board') && request.resource.data.keys().size() == 0
          && getAfter(postDoc(id)).data.likes == get(postDoc(id)).data.likes + 1 && counted();
        allow delete: if (me(l) && !banned(l) && existsAfter(postDoc(id)) && getAfter(postDoc(id)).data.likes == get(postDoc(id)).data.likes - 1 && counted())
          || (owner() && !existsAfter(postDoc(id)));
      }
    }
    match /boardRate/{uid} {
      allow get: if me(uid);
      allow create: if me(uid) && rateFirst(request.resource.data);
      allow update: if me(uid) && rateNext(request.resource.data, resource.data, duration.value(60, 's'), 5);
      allow delete: if me(uid) && (request.time >= resource.data.win + duration.value(1, 'd') || !existsAfter(profileDoc(uid)));
    }
    match /reportRate/{uid} {
      allow get: if me(uid);
      allow create: if me(uid) && rateFirst(request.resource.data);
      allow update: if me(uid) && rateNext(request.resource.data, resource.data, duration.value(0, 's'), 20);
      allow delete: if me(uid) && (request.time >= resource.data.win + duration.value(1, 'd') || !existsAfter(profileDoc(uid)));
    }
    // A ban: an owner's alone to write and list. Anyone signed in may ask whether one account is banned (the rules above ask).
    match /banned/{uid} {
      allow get: if signedIn();
      // The owner's list, to lift a ban (More › Board review).
      allow list: if owner();
      allow create, update: if owner() && request.resource.data.keys().hasOnly(['at', 'why']) && request.resource.data.at == request.time
        && (!('why' in request.resource.data) || (request.resource.data.why is string && request.resource.data.why.size() <= 200));
      allow delete: if owner();
    }
    // What moderation tells an author, on their next board open (no push): how many of their posts an owner removed, and a ban.
    // Only an owner writes it; only its person (or an owner) reads it, and they may clear it with their account.
    match /notices/{uid} {
      allow get: if me(uid) || owner();
      allow create, update: if owner() && request.resource.data.keys().hasOnly(['removed', 'banned', 'at'])
        && request.resource.data.removed is int && request.resource.data.removed >= 0 && request.resource.data.banned is bool
        && request.resource.data.at == request.time;
      allow delete: if me(uid) || owner();
    }

    function monthOk(d) {
      return d.keys().hasOnly(['sets', 'body', 'deleted', 'updatedAt', 'prs'])
        && d.sets is list && d.sets.size() <= 5000 && d.body is list && d.body.size() <= 100
        && d.deleted is map && d.deleted.size() <= 20000 && (!('prs' in d) || (d.prs is list && d.prs.size() <= 5000));
    }
    function metaOk(d, x) {
      return (d == 'index' && x.keys().hasOnly(['months', 'meta']) && x.get('months', {}).size() <= 2400)
        || (d == 'profile' && x.keys().hasOnly(['items', 'updatedAt', 'plansFrom']) && x.items is map && x.items.size() <= 5000)
        || (d.matches('^plans-(19|20)[0-9]{2}$') && x.keys().hasOnly(['items', 'updatedAt']) && x.items is map && x.items.size() <= 400);
    }

    match /users/{uid} {
      // Name only, so a request can say who it's from; `prev` and `changedAt` say what it was ("formerly @…" for 30 days); the
      // display name and when it last changed (`nameAt`); when the account first had a profile (`createdAt`, the server's time,
      // kept for the board's day-old gate; an older app writes none, and a profile without one may add it once, as now); and who
      // may send a friend request (`reqs`: 'any', the default, or 'invite' for invite links only).
      allow get: if signedIn();
      // A first name: one you hold, no display name yet.
      allow create: if me(uid) && request.resource.data.keys().hasOnly(['username', 'displayName', 'createdAt'])
        && request.resource.data.displayName == request.resource.data.username && holdsAfter(uid, request.resource.data.username)
        && (!('createdAt' in request.resource.data) || request.resource.data.createdAt == request.time);
      allow update: if me(uid)
        && request.resource.data.keys().hasOnly(['username', 'displayName', 'prev', 'changedAt', 'nameAt', 'createdAt', 'reqs'])
        && usernameMove(uid, request.resource.data, resource.data)
        && displayMove(request.resource.data, resource.data)
        && (!('reqs' in request.resource.data) || request.resource.data.reqs in ['any', 'invite'])
        && (!('createdAt' in request.resource.data) || request.resource.data.createdAt == resource.data.get('createdAt', request.time));
      allow delete: if me(uid);

      // The log, one document a month (domain/cloud CloudMonth): a month's id, these keys, and counts far past a real month's
      // (a heavy month is ~1,500 sets). With the settings below, an account holds a bounded number of documents.
      match /months/{m} {
        allow read: if me(uid) || friendOf(uid);
        allow delete: if me(uid);
        allow create, update: if me(uid) && m.matches('^(19|20)[0-9]{2}-(0[1-9]|1[0-2])$') && monthOk(request.resource.data);
      }
      // Settings (cloud/sync): the index, the settings document and a day-plan archive a year; nothing else.
      match /meta/{d} {
        allow read: if me(uid) || friendOf(uid);
        allow delete: if me(uid);
        allow create, update: if me(uid) && metaOk(d, request.resource.data);
      }
      // Yours alone, never a friend's to read: the board's (gate, hidden, muted), cycle phase, friend tags, trained-together.
      match /private/{d} {
        allow read, delete: if me(uid);
        allow create, update: if me(uid) && d in ['board', 'cycle', 'tags', 'together']
          && (d != 'board' || (request.resource.data.keys().hasOnly(['ok', 'at', 'hidden', 'muted'])
            && request.resource.data.get('hidden', []).size() <= 200 && request.resource.data.get('muted', []).size() <= 200));
      }
      // Compare: what your phone publishes for friends to set side by side (domain/compare summarize), one small document of
      // per-range numbers and no sets. A friend gets it, one read; nobody lists it but you. Only you write it, in its shape, at
      // the server's time.
      match /summary/{d} {
        allow get: if me(uid) || friendOf(uid);
        allow list: if me(uid);
        allow create, update: if me(uid) && d == 'compare' && summaryOk(request.resource.data);
        allow delete: if me(uid);
      }

      match /friends/{f} {
        allow read: if me(uid);
        allow delete: if me(uid) || me(f);
        // Your own list; or the friend adds themselves, holding your invite (used up in the same write: it works once)
        // or answering their request you sent. Never someone you've blocked.
        allow create: if (me(uid) && request.resource.data.keys().hasOnly(['since', 'via', 'muted', 'readAt']))
          || (me(f) && !blocked(uid, f) && liveInvite(uid, request.resource.data.via)
              && !existsAfter(/databases/$(db)/documents/users/$(uid)/invites/$(request.resource.data.via)))
          || (me(f) && !blocked(uid, f) && exists(/databases/$(db)/documents/users/$(f)/requests/$(uid)));
        // Only yours, and only these two: muting them (they never see it) and when you last read their messages (no read
        // receipts: nobody but you reads your list).
        allow update: if me(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['muted', 'readAt'])
          && (!('muted' in request.resource.data) || request.resource.data.muted is bool)
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['readAt']) || request.resource.data.readAt == request.time);
      }
      // Who you've blocked: yours alone.
      match /blocked/{them} {
        allow read, delete: if me(uid);
        allow create, update: if me(uid) && request.resource.data.keys().hasOnly(['at']);
      }
      // Yours to make (a press of "Make an invite link", counted), a week long at most, and to cancel.
      match /invites/{t} {
        allow read, delete: if me(uid);
        allow create: if me(uid) && t.matches('^[A-Za-z0-9_-]{8,64}$') && request.resource.data.keys().hasOnly(['created', 'expires'])
          && request.resource.data.expires is timestamp && request.resource.data.expires <= request.time + duration.value(8, 'd')
          && counted();
        allow get: if signedIn();
        // Used up by whoever accepts it, in the write that makes them a friend through it (see friends above).
        allow delete: if signedIn() && resource.data.expires > request.time
          && !exists(/databases/$(db)/documents/users/$(uid)/friends/$(request.auth.uid))
          && getAfter(/databases/$(db)/documents/users/$(uid)/friends/$(request.auth.uid)).data.via == t;
      }
      // A request: as yourself, to someone else whose profile takes requests from anyone (`reqs`, absent on a profile from before
      // the setting: anyone), who hasn't blocked you. "Invite only" leaves invite links as the way in.
      match /requests/{from} {
        allow create: if me(from) && from != uid && prof(uid).get('reqs', 'any') == 'any' && !blocked(uid, from)
          && request.resource.data.keys().hasOnly(['username', 'sent']) && request.resource.data.username is string
          && request.resource.data.username.size() <= 60 && !closed('requests') && counted();
        allow read, delete: if me(uid) || me(from);
      }
      // A gym a friend sent you: they create it as themselves, only you read or clear it, nobody rewrites it.
      // Its sender may get that one document back: the push Worker reads it with their token to check the gym is theirs.
      match /gymInbox/{id} {
        allow create: if signedIn() && request.resource.data.from == request.auth.uid && friendOf(uid)
          && request.resource.data.keys().hasOnly(['from', 'fromName', 'gym', 'sent']) && request.resource.data.fromName is string
          && request.resource.data.fromName.size() <= 60 && request.resource.data.gym is map && request.resource.data.gym.size() <= 12
          && request.resource.data.gym.name is string && request.resource.data.gym.name.size() <= 100
          && !closed('messages') && counted();
        allow read, delete: if me(uid);
        allow get: if signedIn() && resource.data.from == request.auth.uid;
      }
      // Pings and messages a friend sent you. They write it as themselves, while they're your friend, with the server's
      // time, a known ping or 1 to 140 characters, and their own send counter moved in the same write (sendRate, below).
      // You read and clear yours; a sender reads back only their own (the app asks with where from == them). Never edited.
      match /inbox/{id} {
        allow create: if friendOf(uid) && request.resource.data.from == request.auth.uid && request.resource.data.at == request.time
          && ((request.resource.data.kind == 'p' && request.resource.data.keys().hasOnly(['from', 'kind', 'e', 'at'])
                && request.resource.data.e in ['strong', 'fire', 'clap', 'gym', 'eyes', 'salute'])
            || (request.resource.data.kind == 'm' && request.resource.data.keys().hasOnly(['from', 'kind', 't', 'at'])
                && request.resource.data.t is string && request.resource.data.t.size() >= 1 && request.resource.data.t.size() <= 140))
          && getAfter(/databases/$(db)/documents/users/$(request.auth.uid)/sendRate/$(uid)).data.at == request.time
          && !closed('messages') && counted();
        allow read: if me(uid) || (signedIn() && resource.data.from == request.auth.uid);
        allow delete: if me(uid);
        allow update: if false;
      }
      // Your own send counter to one friend: 2 s between sends, 30 an hour (a new hour starts the count again). Only
      // removable once its hour is over, or with the account itself (its profile goes in the same write).
      match /sendRate/{to} {
        allow read: if me(uid);
        allow create: if me(uid) && request.resource.data.keys().hasOnly(['at', 'win', 'n'])
          && request.resource.data.at == request.time && request.resource.data.win == request.time && request.resource.data.n == 1;
        allow update: if me(uid) && request.resource.data.keys().hasOnly(['at', 'win', 'n'])
          && request.resource.data.at == request.time && request.time > resource.data.at + duration.value(2, 's')
          && ((request.resource.data.win == resource.data.win && request.resource.data.n == resource.data.n + 1
                && request.resource.data.n <= 30 && request.time < resource.data.win + duration.value(1, 'h'))
            || (request.resource.data.win == request.time && request.resource.data.n == 1
                && request.time >= resource.data.win + duration.value(1, 'h')));
        allow delete: if me(uid) && (request.time >= resource.data.win + duration.value(1, 'h')
          || !existsAfter(/databases/$(db)/documents/users/$(uid)));
      }
    }
  }
}
